---
import { getCollection } from 'astro:content';

export const prerender = false;

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD;
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const REPO_OWNER = 'MICHAELWAY617';
const REPO_NAME = 'my-blog';
const BRANCH = 'master';
const CONTENT_DIR = 'src/content/blog';

// ---- Auth helpers ----
function setAuthCookie(context: any) {
	context.cookies.set('admin_auth', 'true', {
		httpOnly: true,
		secure: true,
		sameSite: 'lax',
		path: '/admin',
		maxAge: 60 * 60 * 24,
	});
}

function isAuthenticated(context: any) {
	return context.cookies.get('admin_auth')?.value === 'true';
}

// ---- Handle POST ----
let message = '';
let error = '';

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const action = formData.get('action')?.toString();

	if (action === 'login') {
		const password = formData.get('password')?.toString();
		if (password === ADMIN_PASSWORD) {
			setAuthCookie(Astro);
			message = '登录成功';
		} else {
			error = '密码错误';
		}
	} else if (action === 'save' && isAuthenticated(Astro)) {
		const filename = formData.get('filename')?.toString();
		const content = formData.get('content')?.toString();

		if (filename && content !== undefined) {
			try {
				// Get existing file SHA
				const getUrl = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_DIR}/${filename}?ref=${BRANCH}`;
				const getRes = await fetch(getUrl, {
					headers: {
						Authorization: `Bearer ${GITHUB_TOKEN}`,
						Accept: 'application/vnd.github+json',
						'X-GitHub-Api-Version': '2022-11-28',
					},
				});
				const existing = await getRes.json();
				const sha = existing.sha || null;

				// Create or update file
				const body: any = {
					message: `✏️ admin: update ${filename}\n\nCo-Authored-By: WayLog Admin <admin@waylog.dev>`,
					content: Buffer.from(content).toString('base64'),
					branch: BRANCH,
				};
				if (sha) body.sha = sha;

				const putUrl = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_DIR}/${filename}`;
				const putRes = await fetch(putUrl, {
					method: 'PUT',
					headers: {
						Authorization: `Bearer ${GITHUB_TOKEN}`,
						Accept: 'application/vnd.github+json',
						'X-GitHub-Api-Version': '2022-11-28',
					},
					body: JSON.stringify(body),
				});

				if (putRes.ok) {
					message = `✅ 「${filename}」保存成功，Vercel 自动部署中...`;
				} else {
					const errBody = await putRes.json();
					error = `保存失败: ${JSON.stringify(errBody)}`;
				}
			} catch (e: any) {
				error = `请求异常: ${e.message}`;
			}
		}
	} else if (action === 'delete' && isAuthenticated(Astro)) {
		const filename = formData.get('filename')?.toString();
		if (filename) {
			try {
				const getUrl = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_DIR}/${filename}?ref=${BRANCH}`;
				const getRes = await fetch(getUrl, {
					headers: {
						Authorization: `Bearer ${GITHUB_TOKEN}`,
						Accept: 'application/vnd.github+json',
						'X-GitHub-Api-Version': '2022-11-28',
					},
				});
				const existing = await getRes.json();
				if (existing.sha) {
					const delRes = await fetch(getUrl, {
						method: 'DELETE',
						headers: {
							Authorization: `Bearer ${GITHUB_TOKEN}`,
							Accept: 'application/vnd.github+json',
							'X-GitHub-Api-Version': '2022-11-28',
						},
						body: JSON.stringify({
							message: `🗑️ admin: delete ${filename}\n\nCo-Authored-By: WayLog Admin <admin@waylog.dev>`,
							sha: existing.sha,
							branch: BRANCH,
						}),
					});
					if (delRes.ok) {
						message = `🗑️ 「${filename}」已删除`;
					} else {
						error = `删除失败: ${JSON.stringify(await delRes.json())}`;
					}
				}
			} catch (e: any) {
				error = `请求异常: ${e.message}`;
			}
		}
	} else {
		error = '请先登录';
	}
}

// ---- Load posts ----
const posts = isAuthenticated(Astro)
	? (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	: [];

// Pre-fetch content for edit mode
let editContent = '';
let editFilename = '';
let editTitle = '';
const editSlug = Astro.url.searchParams.get('edit');
if (editSlug && isAuthenticated(Astro)) {
	const post = posts.find(p => p.id === editSlug);
	if (editSlug === 'new') {
		editFilename = `new-post-${Date.now()}.md`;
		editTitle = '新建文章';
		editContent = `---
title: '新文章标题'
description: '文章摘要'
pubDate: '${new Date().toISOString().slice(0, 10)}'
---

在这里写正文...`;
	} else if (post) {
		editFilename = `${post.id}.md`;
		editTitle = post.data.title;
		try {
			const getUrl = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_DIR}/${editFilename}?ref=${BRANCH}`;
			const getRes = await fetch(getUrl, {
				headers: {
					Authorization: `Bearer ${GITHUB_TOKEN}`,
					Accept: 'application/vnd.github+json',
					'X-GitHub-Api-Version': '2022-11-28',
				},
			});
			const data = await getRes.json();
			if (data.content) {
				editContent = Buffer.from(data.content, 'base64').toString('utf-8');
			}
		} catch {}
	}
}
---

<!doctype html>
<html lang="zh-CN">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>WayLog Admin</title>
	<style>
		* { box-sizing: border-box; margin: 0; padding: 0; }
		body { font-family: system-ui, sans-serif; background: #f8f9fa; color: #1a1a2e; line-height: 1.6; }
		.container { max-width: 960px; margin: 0 auto; padding: 2em 1em; }
		h1 { font-size: 1.5em; margin-bottom: 0.5em; }
		.login-box { max-width: 400px; margin: 80px auto; background: #fff; padding: 2em; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
		.login-box input { width: 100%; padding: 0.75em; border: 1px solid #ddd; border-radius: 6px; font-size: 1em; margin: 0.5em 0; }
		.btn { display: inline-block; padding: 0.6em 1.2em; border: none; border-radius: 6px; font-size: 0.95em; cursor: pointer; text-decoration: none; }
		.btn-primary { background: #1a1a2e; color: #fff; }
		.btn-primary:hover { background: #333; }
		.btn-danger { background: #e74c3c; color: #fff; }
		.btn-danger:hover { background: #c0392b; }
		.btn-sm { padding: 0.3em 0.7em; font-size: 0.85em; }
		.msg { padding: 0.75em; border-radius: 6px; margin-bottom: 1em; }
		.msg-success { background: #d4edda; color: #155724; }
		.msg-error { background: #f8d7da; color: #721c24; }
		.post-list { list-style: none; }
		.post-item { background: #fff; padding: 1em 1.2em; margin-bottom: 0.5em; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
		.post-item .title { font-weight: 600; }
		.post-item .date { color: #888; font-size: 0.85em; }
		.editor-box { background: #fff; padding: 1.5em; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); margin-top: 1em; }
		.editor-box textarea { width: 100%; min-height: 400px; font-family: 'Courier New', monospace; font-size: 0.9em; padding: 1em; border: 1px solid #ddd; border-radius: 6px; line-height: 1.5; }
		.editor-box label { font-weight: 600; display: block; margin-bottom: 0.3em; }
		.editor-box .filename { color: #888; font-size: 0.85em; margin-bottom: 0.5em; }
		.actions { display: flex; gap: 0.5em; margin-top: 1em; }
		.back-link { margin-bottom: 1.5em; }
		.header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5em; border-bottom: 1px solid #ddd; padding-bottom: 0.75em; }
	</style>
</head>
<body>
<div class="container">
{
	!isAuthenticated(Astro) ? (
		<div class="login-box">
			<h1>🔐 WayLog Admin</h1>
			{error && <div class="msg msg-error">{error}</div>}
			<form method="POST">
				<input type="hidden" name="action" value="login" />
				<label>管理员密码</label>
				<input type="password" name="password" placeholder="输入密码..." autofocus />
				<button type="submit" class="btn btn-primary" style="margin-top:0.75em;width:100%">登录</button>
			</form>
		</div>
	) : editSlug ? (
		<>
			<div class="back-link"><a href="/admin">&larr; 返回文章列表</a></div>
			{message && <div class="msg msg-success">{message}</div>}
			{error && <div class="msg msg-error">{error}</div>}
			<div class="editor-box">
				<h2>{editTitle}</h2>
				<div class="filename">📄 {editFilename}</div>
				<form method="POST">
					<input type="hidden" name="action" value="save" />
					<input type="hidden" name="filename" value={editFilename} />
					<label>Markdown 正文</label>
					<textarea name="content">{editContent}</textarea>
					<div class="actions">
						<button type="submit" class="btn btn-primary">💾 保存到 GitHub</button>
						<a href="/admin" class="btn" style="background:#eee">取消</a>
					</div>
				</form>
			</div>
		</>
	) : (
		<>
			<div class="header-bar">
				<h1>🛠️ WayLog Admin</h1>
				<span style="color:#888;font-size:0.85em">{posts.length} 篇文章</span>
			</div>
			{message && <div class="msg msg-success">{message}</div>}
			{error && <div class="msg msg-error">{error}</div>}

			<p style="margin-bottom:1em">
				<a href={`/admin?edit=new&t=${Date.now()}`} class="btn btn-primary">＋ 新建文章</a>
			</p>

			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-item">
						<div>
							<div class="title">{post.data.title}</div>
							<div class="date">{post.data.pubDate.toISOString().slice(0, 10)}</div>
						</div>
						<div class="actions">
							<a href={`/admin?edit=${post.id}`} class="btn btn-sm btn-primary">✏️ 编辑</a>
							<form method="POST" style="display:inline" onsubmit="return confirm('确定删除「{post.data.title}」？')">
								<input type="hidden" name="action" value="delete" />
								<input type="hidden" name="filename" value={`${post.id}.md`} />
								<button type="submit" class="btn btn-sm btn-danger">🗑️</button>
							</form>
						</div>
					</li>
				))}
			</ul>
			{posts.length === 0 && <p style="color:#888">暂无文章</p>}
		</>
	)
}
</div>
</body>
</html>
